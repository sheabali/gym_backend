# -----------------------------------------------------------------------------
# Gym Management System - Backend Environment Configuration Example
# Copy this file to .env and configure with your local or deployment secrets.
# NEVER commit a real .env file to version control.
# -----------------------------------------------------------------------------

# Application Environment (development | test | production)
NODE_ENV=development

# Server Port
PORT=8000

# MongoDB Connection String (must be a replica set URI, default for MongoDB Atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Allowed CORS Origin(s) - e.g., http://localhost:3000 or comma-separated origins
CORS_ORIGIN=http://localhost:3000

# Pino Log Level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=debug

# Rate Limiting: Window duration in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Rate Limiting: Maximum requests allowed per IP in the window
RATE_LIMIT_MAX=100

# Authentication
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# Application URLs
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:3000"

# SSLCommerz Payment Gateway (Credentials for sandbox/live)
SSLCOMMERZ_STORE_ID="your_sslcommerz_store_id"
SSLCOMMERZ_STORE_PASS="your_sslcommerz_store_pass"
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_GATEWAY_MODE=fake # fake | sandbox | live
